        "$description": "Default UI and body typeface: compact, clear, and friendly under operational density."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["DM Mono", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Soft but controlled corners; sm/md/lg/xl derive from this in the theme."
